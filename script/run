#!/bin/sh
# Runs a command in the project's root, after putting each .bend file's
# defs in the order Bend needs. Bend runs locally by default. To run it on
# another machine, set BEND_HOST to an ssh destination: the project is
# copied there with rsync, to BEND_DIR (default yaml-for-bend, relative to the
# remote home), and the command runs in that copy.
#
#   script/run bend src/yaml.bend --check-only
#   BEND_HOST=user@build-box script/run bend src/yaml.bend --check-only
set -e
cd "$(dirname "$0")/.."
script/order src/*.bend test/*.bend examples/*.bend
if [ -z "$BEND_HOST" ]; then
  exec sh -c "$*"
fi
dir=${BEND_DIR:-yaml-for-bend}
rsync -a --delete --exclude .git --exclude build ./ "$BEND_HOST:$dir/"
ssh "$BEND_HOST" "cd $dir && $*"
